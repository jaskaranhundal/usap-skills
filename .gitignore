# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.py[cod]

# Local secrets / one-off scripts (never commit tokens)
*.token
.env

# One-off bootstrap pusher (pushes directly to main via PAT — keep local only)
push_usap.py

# references/ is a local-only scratch space for inspecting upstream skill repos.
# Do not check anything under references/ into git.
references/

# Local-only handover planning doc, never publish
USAP_ClaudeCode_Handover.md

# Strategic research / competitive analysis kept on local disk only.
references/private-research/

# Local-only launch playbook — never publish (paste-ready posts, awesome-list PR drafts)
LAUNCH.md
LAUNCH_KIT.md

# Claude Code session-local files — hardcoded $HOME paths, auto-approve rules; never publish
# (the rest of .claude/ — commands/, skills/ — IS load-bearing and stays tracked)
.claude/settings.local.json
.claude/launch.json
.claude/settings.json

# Audit logs generated by usap_loop_demo / mcp_audit — regeneratable, never commit
reports/**/_audit/

# Multi-agent worktree scratch space — never commit
.claude/worktrees/

