{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "USAP Bundle Generator (lite)",
      "runtimeExecutable": "/usr/bin/python3",
      "runtimeArgs": ["/tmp/usap_server.py"],
      "port": 8080
    },
    {
      "name": "Gemini Chat CLI",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["shared/scripts/gemini_chat.py", "--kit", "lite"],
      "port": 8081
    },
    {
      "name": "AnythingLLM Workspace Setup (localhost:3001)",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["anythingllm-package/setup_workspaces.py", "--url", "http://localhost:3001"],
      "port": 3001
    },
    {
      "name": "USAP Test Harness (requires Ollama on :11434)",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["tests/run_all.sh"],
      "port": 11434
    }
  ]
}
